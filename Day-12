#include <stdio.h>

int palindrome(int n)
{
    int rev = 0, rem, temp;
    temp = n;

    while(n > 0)
    {
        rem = n % 10;
        rev = rev * 10 + rem;
        n = n / 10;
    }

    if(temp == rev)
        return 1;
    else
        return 0;
}
#include <stdio.h>
#include <math.h>

int armstrong(int n)
{
    int temp, rem, sum = 0, count = 0;

    temp = n;

    while(temp != 0)
    {
        count++;
        temp = temp / 10;
    }

    temp = n;

    while(temp != 0)
    {
        rem = temp % 10;
        sum = sum + pow(rem, count);
        temp = temp / 10;
    }

    if(sum == n)
        return 1;
    else
        return 0;
}

int main()
{
    int num;

    printf("Enter number: ");
    scanf("%d", &num);

    if(armstrong(num))
        printf("Armstrong number");
    else
        printf("Not Armstrong number");

    return 0;
}

