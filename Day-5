#include <stdio.h>

int main() {
    int n, i, sum = 0;

    printf("Enter a number: ");
    scanf("%d", &n);

    for(i = 1; i < n; i++) {
        if(n % i == 0) {
            sum += i;
        }
    }

    if(sum == n)
        printf("%d is a Perfect Number.", n);
    else
        printf("%d is not a Perfect Number.", n);

    return 0;
}
#include <stdio.h>

int factorial(int n)
{
    int fact = 1;
    for(int i = 1; i <= n; i++)
    {
        fact = fact * i;
    }
    return fact;
}

int main()
{
    int start, end, num, temp, digit, sum;

    printf("Enter start and end of range: ");
    scanf("%d %d", &start, &end);

    printf("Strong numbers are:\n");

    for(num = start; num <= end; num++)
    {
        temp = num;
        sum = 0;

        while(temp > 0)
        {
            digit = temp % 10;
            sum += factorial(digit);
            temp /= 10;
        }

        if(sum == num)
        {
            printf("%d ", num);
        }
    }

    return 0;
}
