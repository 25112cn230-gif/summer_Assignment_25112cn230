#include <stdio.h>

int main() {
    long long n, largestFactor = -1;

    printf("Enter a number: ");
    scanf("%lld", &n);

    while (n % 2 == 0) {
        largestFactor = 2;
        n /= 2;
    }

    for (long long i = 3; i * i <= n; i += 2) {
        while (n % i == 0) {
            largestFactor = i;
            n /= i;
        }
    }

    if (n > 2)
        largestFactor = n;

    printf("Largest Prime Factor = %lld", largestFactor);

    return 0;
}
